rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function positiveAmount(field) { return request.resource.data[field] is number && request.resource.data[field] >= 0; }

    match /users/{uid} {
      allow read, write: if owns(uid);

      match /transactions/{transaction} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && request.resource.data.tipo in ['expense', 'income', 'transfer', 'loan', 'loan_payment', 'receivable_payment', 'payable_payment', 'credit_card_charge', 'credit_card_payment', 'scheduled_payment']
          && request.resource.data.monto > 0;
        allow update: if owns(uid)
          && !('monto' in request.resource.data.diff(resource.data).affectedKeys())
          && !('cuenta' in request.resource.data.diff(resource.data).affectedKeys());
        allow delete: if false;
      }

      match /accounts/{account} {
        allow read: if owns(uid);
        allow create: if owns(uid) && request.resource.data.nombre != null && positiveAmount('saldo');
        allow update: if owns(uid);
        allow delete: if false;
      }

      match /categories/{category} {
        allow read: if owns(uid);
        allow create: if owns(uid) && request.resource.data.nombre != null;
        allow update: if owns(uid);
        allow delete: if false;
      }

      match /people/{person} {
        allow read: if owns(uid);
        allow create: if owns(uid) && request.resource.data.nombre != null;
        allow update: if owns(uid);
        allow delete: if owns(uid);
      }

      match /creditCards/{card} {
        allow read: if owns(uid);
        allow create: if owns(uid) && request.resource.data.nombre != null && request.resource.data.lineaCredito >= 0;
        allow update: if owns(uid);
        allow delete: if false;
      }

      match /wallets/{wallet} {
        allow read, create, update: if owns(uid);
        allow delete: if false;
      }

      match /receivableDebts/{debt} {
        allow read, create, update: if owns(uid);
        allow delete: if false;
      }
      match /receivablePayments/{payment} {
        allow read, create: if owns(uid) && request.resource.data.amount > 0;
        allow update, delete: if false;
      }
      match /payableObligations/{obligation} {
        allow read, create, update: if owns(uid);
        allow delete: if false;
      }
      match /payablePayments/{payment} {
        allow read, create: if owns(uid) && request.resource.data.amount > 0;
        allow update, delete: if false;
      }
      match /scheduledPayments/{payment} {
        allow read, create, update: if owns(uid);
        allow delete: if false;
        match /periods/{period} {
          allow read, create, update: if owns(uid)
            && (!('status' in request.resource.data.keys()) || request.resource.data.status in ['pending', 'paid', 'overdue', 'skipped']);
          allow delete: if false;
        }
      }
      match /incomes/{income} {
        allow read, create, update: if owns(uid);
        allow delete: if false;
      }
      match /subscriptions/{subscription} {
        allow read, create, update: if owns(uid);
        allow delete: if false;
      }
      match /settings/{document=**} { allow read, write: if owns(uid); }
      match /{document=**} { allow read, write: if owns(uid); }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
